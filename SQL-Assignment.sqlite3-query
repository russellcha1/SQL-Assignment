-- Part 1
-- Q1
SELECT COUNT(*)
FROM Invoice;

--Q2
SELECT COUNT(DISTINCT CustomerId)
FROM Customer;

--Q3
SELECT SUM(Total)
FROM Invoice;

--Q4
SELECT AVG(Total), MIN(Total), MAX(Total)
FROM Invoice


--PART 2
--Q5

SELECT Country, Count(*)
FROM Customer
Group By Country;

--Q6
SELECT BillingCountry, SUM(total)
FROM invoice
GROUP BY BillingCountry
ORDER BY SUM(total) DESC;

--Q7

SELECT BillingCountry, SUM(total), COUNT(*)
FROM invoice
GROUP BY BillingCountry
HAVING COUNT(*) > 5
ORDER BY SUM(total) DESC;

--Q8
SELECT BillingCountry, AVG(total)
FROM invoice
GROUP BY BillingCountry
ORDER BY AVG(total) DESC;

-- Part 3
--Q9
SELECT COUNT(*),
CASE
    WHEN Total < 5.00 THEN 'Small'
    WHEN Total BETWEEN 5.00 AND 10 THEN 'Medium'
    ELSE 'Large'
    END AS InvoiceClass

FROM invoice
GROUP BY InvoiceClass;

--Q10

SELECT BillingCountry,
CASE
    WHEN Count(*) < 2 THEN 'LOW'
    WHEN Count(*) BETWEEN 3 and 5 THEN 'Medium'
    ELSE 'High'
    END AS PurchaseAmount
FROM invoice
GROUP BY BillingCountry;

--Part4
--Q11
SELECT CustomerId, COUNT(*)
FROM Invoice
GROUP BY CustomerId;

--Q12
SELECT CustomerId,
CASE WHEN SUM(Total) < 20 THEN 'Low Value'
WHEN SUM(Total) BETWEEN 20 AND 40 THEN 'Medium Value'
ELSE 'High Value'
END AS 'Customer Value'
FROM invoice
GROUP BY CustomerId;

--Q13
SELECT COUNT(*),
CASE
    WHEN Total < 2.00 THEN 'Mild'
    WHEN Total BETWEEN 2.00 AND 5 THEN 'Medium'
    WHEN Total BETWEEN 5.00 AND 10 THEN 'Hot'
    ELSE 'Diablo'
    END AS InvoiceClass

FROM invoice
GROUP BY InvoiceClass;

--Q14
SELECT CustomerId, 
COUNT(*) AS 'Number of Purchases', 
SUM(Total) AS 'Total Money Spent', 
ROUND(AVG(Total),2) AS 'Average Purchase Amount',
MAX(Total) AS 'Largest Purchase'
FROM invoice
GROUP BY CustomerId
